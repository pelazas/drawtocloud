# --- Supabase ---

# Supabase project URL (required)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key — used by frontend (required)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase service role key — used by backend for server-side ops (required)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# --- LLM Providers (first found wins; at least one required for generation) ---

# Anthropic API key — preferred provider (optional, default: not set)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — fallback provider (optional, default: not set)
OPENAI_API_KEY=sk-...

# OpenRouter API key — last-resort fallback provider (optional, default: not set)
OPENROUTER_API_KEY=sk-or-...

# --- BYOK (Bring Your Own Key) ---

# Fernet encryption secret for storing per-user LLM keys (required if BYOK is enabled)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_SECRET=your-fernet-secret

# --- AWS (for real-time cost estimation via AWS Pricing API) ---

# AWS access key ID (optional, default: not set — falls back to static pricing)
AWS_ACCESS_KEY_ID=AKIA...

# AWS secret access key (optional, default: not set — falls back to static pricing)
AWS_SECRET_ACCESS_KEY=your-aws-secret

# --- Access control ---

# Comma-separated list of admin email addresses (optional, default: empty)
ADMIN_EMAILS=admin@example.com,ops@example.com

# --- CORS ---

# Comma-separated list of allowed frontend origins (optional, default: http://localhost:3000,http://localhost:3100)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Logging ---

# Log level for backend application loggers (optional, default: INFO)
LOG_LEVEL=INFO

# --- Frontend public vars ---

# WebSocket URL seen by the browser (optional, default: /ws which proxies through nginx)
NEXT_PUBLIC_WS_URL=/ws

# REST API base URL seen by the browser (optional, default: empty — same origin)
NEXT_PUBLIC_API_URL=

# Supabase public URL for the frontend client (same value as SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key for the frontend client (same value as SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Default template slug shown on the dashboard (optional, default: aie84ypr)
NEXT_PUBLIC_DEFAULT_TEMPLATE_SLUG=aie84ypr
